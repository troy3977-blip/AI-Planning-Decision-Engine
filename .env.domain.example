# Domain Configuration Environment Variables

# Copy this file to a .env file and update with your values
# This is used for both local testing and Azure App Service configuration

# ============================================
# CUSTOM DOMAIN CONFIGURATION
# ============================================

# Your custom domain name
CUSTOM_DOMAIN=wfm.example.com

# Azure App Service configuration
AZURE_APP_NAME=smartwfmai
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_SUBSCRIPTION_ID=your-subscription-id

# ============================================
# STREAMLIT SERVER CONFIGURATION
# ============================================

STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
STREAMLIT_SERVER_ENABLE_CORS=true

# Allowed origins (comma-separated)
# Include your custom domain, the Azure domain, and localhost for dev
STREAMLIT_SERVER_ALLOWED_ORIGINS=localhost:3000,127.0.0.1:8501,smartwfmai.azurewebsites.net,wfm.example.com

# ============================================
# CLIENT-SIDE CONFIGURATION
# ============================================

STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=false
STREAMLIT_CLIENT_TOOLBAR_MODE=viewer

# ============================================
# SSL/TLS CONFIGURATION
# ============================================

# SSL certificate thumbprint (obtained from Azure)
SSL_CERT_THUMBPRINT=

# Enable HTTPS only
HTTPS_ONLY=true

# ============================================
# ENVIRONMENT DESIGNATION
# ============================================

ENVIRONMENT=production

# ============================================
# LOGGING & MONITORING
# ============================================

LOG_LEVEL=INFO
ENABLE_DIAGNOSTICS=true

# ============================================
# OPTIONAL: DNS PROVIDER CREDENTIALS
# ============================================
# Only needed if managing DNS programmatically

# For Azure DNS
AZURE_DNS_ZONE=
AZURE_DNS_RESOURCE_GROUP=

# For other DNS providers (if used)
DNS_PROVIDER=
DNS_API_KEY=
DNS_API_SECRET=

# ============================================
# OPTIONAL: CI/CD & DEPLOYMENT
# ============================================

# GitHub Actions deployment
GITHUB_REPO_URL=https://github.com/your-org/AI-Planning-Decision-Engine
GITHUB_BRANCH=main

# Deployment slot (for staging/production)
DEPLOYMENT_SLOT=production

# ============================================
# OPTIONAL: APPLICATION-SPECIFIC
# ============================================

# OpenAI/AI configuration (if needed)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Database or external services
DATABASE_URL=
API_ENDPOINT=
